# Copy this file to .env (same folder) and fill in the two values.
# .env is git-ignored, so your values never go to GitHub.
#
# Where to find them: Supabase dashboard → your project → Connect (or Project Settings → API Keys).
# Use the PUBLISHABLE key (starts with sb_publishable_). Never the secret key (sb_secret_...)
# or the legacy service_role key: those skip Row Level Security, and the app refuses to start with them.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
